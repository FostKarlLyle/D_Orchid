<%- include('../partials/head', { title: title, nav: 'admin-nav', active: 'dashboard' }) %>

<!-- Ringkasan umum -->
<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-icon i-violet"><i class="bi bi-cash-stack"></i></div>
    <div>
      <div class="stat-label">Total Pendapatan</div>
      <div class="stat-value"><%= formatRp(stats.revenue) %></div>
      <div class="stat-note">Bulan ini <%= formatRp(stats.monthRevenue) %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon i-pink"><i class="bi bi-bag-check"></i></div>
    <div>
      <div class="stat-label">Total Pesanan</div>
      <div class="stat-value"><%= stats.orders %></div>
      <div class="stat-note"><%= stats.pending %> menunggu konfirmasi</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon i-teal"><i class="bi bi-flower2"></i></div>
    <div>
      <div class="stat-label">Anggrek Tersedia</div>
      <div class="stat-value"><%= stats.sellableStock %> <span style="font-size:13px;font-weight:600;color:var(--muted)">pot</span></div>
      <div class="stat-note"><%= stats.catalogActive %> produk di katalog · <%= stats.orchids %> data anggrek</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon i-amber"><i class="bi bi-people"></i></div>
    <div>
      <div class="stat-label">Customer</div>
      <div class="stat-value"><%= stats.customers %></div>
      <div class="stat-note"><%= stats.reviews %> ulasan terkumpul</div>
    </div>
  </div>
</div>

<!-- Ringkasan anggrek per jenis & fase -->
<div class="grid-2">
  <div class="panel panel-pad">
    <div class="panel-title"><i class="bi bi-bar-chart-fill"></i> Jumlah Anggrek per Jenis</div>
    <div class="panel-sub">Ringkasan data anggrek berdasarkan jenisnya</div>
    <% if (!byJenis.length) { %>
      <div class="empty-state"><i class="bi bi-bar-chart"></i><div class="title">Belum ada data anggrek</div></div>
    <% } %>
    <% byJenis.forEach(function (r) { %>
      <div class="bar-row">
        <div class="bar-name"><%= r.jenis %></div>
        <div class="bar-track"><div class="bar-fill" style="width: <%= Math.round((r.jumlah / maxJenis) * 100) %>%"></div></div>
        <div class="bar-val"><%= r.jumlah %></div>
      </div>
    <% }) %>
  </div>

  <div class="panel panel-pad">
    <div class="panel-title"><i class="bi bi-graph-up-arrow"></i> Jumlah Anggrek per Fase Pertumbuhan</div>
    <div class="panel-sub">Distribusi fase: bibit, anakan, remaja, dewasa, hingga berbunga</div>
    <% byFase.forEach(function (r) { %>
      <div class="bar-row">
        <div class="bar-name"><span class="badge badge-fase <%= FASE_BADGE[r.fase] %>"><%= r.fase %></span></div>
        <div class="bar-track"><div class="bar-fill" style="width: <%= Math.round((r.jumlah / maxFase) * 100) %>%"></div></div>
        <div class="bar-val <%= r.jumlah === 0 ? 'zero' : '' %>"><%= r.jumlah %></div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Stok tersedia untuk dijual + pesanan terbaru -->
<div class="grid-2-1">
  <div class="panel">
    <div class="panel-pad pb-2">
      <div class="panel-title"><i class="bi bi-box-seam"></i> Stok Anggrek Tersedia untuk Dijual</div>
      <div class="panel-sub">Status stok produk yang aktif di katalog</div>
    </div>
    <div class="table-responsive">
      <table class="table table-them align-middle">
        <thead>
          <tr>
            <th>Anggrek</th>
            <th>Fase</th>
            <th>Harga</th>
            <th>Stok</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (!stock.length) { %>
            <tr><td colspan="5">
              <div class="empty-state"><i class="bi bi-shop"></i><div class="title">Katalog masih kosong</div>
              Tambahkan data anggrek lewat tombol <b>+</b> di menu Katalog.</div>
            </td></tr>
          <% } %>
          <% stock.forEach(function (s) { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <% if (s.image) { %>
                    <img src="<%= s.image %>" class="cell-thumb" alt="" />
                  <% } else { %>
                    <div class="cell-thumb empty">🌱</div>
                  <% } %>
                  <div>
                    <div class="cell-title"><%= s.name %></div>
                    <div class="cell-sub"><%= s.jenis %> · <%= s.varietas || '-' %><% if (!s.is_active) { %> · <span class="text-danger">nonaktif</span><% } %></div>
                  </div>
                </div>
              </td>
              <td><span class="badge badge-fase <%= FASE_BADGE[s.fase] %>"><%= s.fase %></span></td>
              <td class="price-tag"><%= formatRp(s.price) %></td>
              <td><b><%= s.stock %></b> pot</td>
              <td><span class="badge <%= stockInfo(s.stock).cls %>"><%= stockInfo(s.stock).label %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <div class="panel-pad pb-2">
      <div class="panel-title"><i class="bi bi-clock-history"></i> Pesanan Terbaru</div>
      <div class="panel-sub">5 pesanan terakhir masuk</div>
    </div>
    <div class="panel-pad pt-2">
      <% if (!recentOrders.length) { %>
        <div class="empty-state"><i class="bi bi-bag"></i><div class="title">Belum ada pesanan</div></div>
      <% } %>
      <% recentOrders.forEach(function (o) { %>
        <div class="mb-3 pb-3" style="border-bottom:1px solid var(--line)">
          <div class="order-head">
            <a class="link-plain" href="/admin/pesanan/<%= o.id %>">#<%= o.id %> — <%= o.customer_name %></a>
            <span class="badge <%= statusInfo(o.status).cls %>"><%= statusInfo(o.status).label %></span>
          </div>
          <div class="cell-sub mt-1"><%= formatDate(o.created_at) %></div>
          <div class="cell-sub"><i class="bi bi-cart3 me-1"></i><%= o.items || '-' %></div>
          <div class="price-tag mt-1"><%= formatRp(o.total) %></div>
        </div>
      <% }) %>
      <a href="/admin/pesanan" class="btn-soft d-inline-block text-decoration-none">
        Lihat semua pesanan <i class="bi bi-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
