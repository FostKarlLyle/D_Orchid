<%- include('../partials/head', { title: title, nav: 'admin-nav', active: 'ulasan' }) %>

<div class="page-head">
  <div>
    <h1>Ulasan</h1>
    <div class="sub">Lihat, balas, dan hapus ulasan customer</div>
  </div>
</div>

<% if (!reviews.length) { %>
  <div class="panel">
    <div class="empty-state">
      <i class="bi bi-star"></i>
      <div class="title">Belum ada ulasan</div>
      Ulasan customer akan muncul di sini.
    </div>
  </div>
<% } %>

<% reviews.forEach(function (r) { %>
  <div class="panel panel-pad mb-4">
    <div class="d-flex flex-wrap justify-content-between gap-3">
      <div class="d-flex gap-3 align-items-center">
        <div class="avatar"><%= (r.customer_name || '?').trim().charAt(0).toUpperCase() %></div>
        <div>
          <div class="cell-title"><%= r.customer_name || 'Akun dihapus' %></div>
          <div class="review-meta"><%= formatDate(r.created_at) %></div>
        </div>
      </div>
      <div class="text-end">
        <div class="stars">
          <% for (var s = 1; s <= 5; s++) { %>
            <span class="<%= s <= r.rating ? '' : 'dim' %>">★</span>
          <% } %>
          <b class="ms-1"><%= r.rating %>/5</b>
        </div>
        <div class="review-meta">untuk <b><%= r.orchid_name || 'Produk dihapus' %></b></div>
      </div>
    </div>

    <p class="mt-3 mb-3" style="font-size:14.5px"><%= r.comment %></p>

    <% if (r.reply) { %>
      <div class="reply-box">
        <b><i class="bi bi-reply me-1"></i>Balasan Admin</b> <span class="review-meta">· <%= r.replied_at ? formatDate(r.replied_at) : '' %></span>
        <div class="mt-1"><%= r.reply %></div>
      </div>
      <div class="d-flex gap-2 mt-3">
        <form method="post" action="/admin/ulasan/<%= r.id %>/balas" class="d-flex gap-2 flex-grow-1">
          <input type="text" name="reply" class="form-control" placeholder="Ubah balasan..." required value="<%= r.reply %>" />
          <button class="btn-soft" type="submit">Ubah</button>
        </form>
        <form method="post" action="/admin/ulasan/<%= r.id %>/hapus" onsubmit="return confirm('Hapus ulasan ini?')">
          <button class="btn-icon b-del" type="submit" title="Hapus ulasan"><i class="bi bi-trash3"></i></button>
        </form>
      </div>
    <% } else { %>
      <div class="d-flex gap-2">
        <form method="post" action="/admin/ulasan/<%= r.id %>/balas" class="d-flex gap-2 flex-grow-1">
          <input type="text" name="reply" class="form-control" placeholder="Tulis balasan untuk customer..." required />
          <button class="btn-accent" type="submit"><i class="bi bi-send me-1"></i> Balas</button>
        </form>
        <form method="post" action="/admin/ulasan/<%= r.id %>/hapus" onsubmit="return confirm('Hapus ulasan ini?')">
          <button class="btn-icon b-del" type="submit" title="Hapus ulasan"><i class="bi bi-trash3"></i></button>
        </form>
      </div>
    <% } %>
  </div>
<% }) %>

<%- include('../partials/foot') %>
