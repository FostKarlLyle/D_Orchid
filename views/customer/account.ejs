<%- include('../partials/head', { title: title, nav: 'customer-nav', active: 'akun' }) %>

<div class="page-head">
  <div>
    <h1>Data Akun</h1>
    <div class="sub"><%= mode === 'edit' ? 'Mode edit — ubah data profil lalu simpan' : (mode === 'password' ? 'Ganti password — wajib isi password saat ini' : 'Lihat data akun kamu') %></div>
  </div>
</div>

<div class="grid-2-1">
  <div class="panel panel-pad">
    <div class="panel-title"><i class="bi bi-person-badge"></i> Profil Saya</div>
    <div class="panel-sub">Role: <span class="badge bg-success">Customer</span> · terdaftar <%= formatDateOnly(akun.created_at) %></div>

    <% if (mode === 'edit') { %>
    <form method="post" action="/customer/akun" class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Nama Lengkap *</label>
        <input type="text" name="name" class="form-control" required value="<%= akun.name %>" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Email *</label>
        <input type="email" name="email" class="form-control" required value="<%= akun.email %>" />
      </div>
      <div class="col-md-6">
        <label class="form-label">No. HP</label>
        <input type="text" name="phone" class="form-control" value="<%= akun.phone %>" placeholder="08xx-xxxx-xxxx" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Alamat Pengiriman</label>
        <input type="text" name="address" class="form-control" value="<%= akun.address %>" placeholder="Alamat lengkap" />
      </div>
      <div class="col-12 d-flex gap-2 flex-wrap">
        <button class="btn-accent" type="submit"><i class="bi bi-check2-circle me-1"></i> Simpan Perubahan</button>
        <a class="btn-soft text-decoration-none" href="/customer/akun"><i class="bi bi-x-lg me-1"></i> Batal</a>
      </div>
    </form>

    <% } else if (mode === 'password') { %>
    <form method="post" action="/customer/akun/password" class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Password Saat Ini *</label>
        <input type="password" name="current" class="form-control" required autocomplete="current-password" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Password Baru *</label>
        <input type="password" id="newpw" name="newpw" class="form-control" required minlength="8" autocomplete="new-password" />
        <div class="pw-rules" aria-live="polite">
          <span id="pwLen">min. 8 karakter</span>
          <span id="pwLetter">ada huruf</span>
          <span id="pwDigit">ada angka</span>
        </div>
      </div>
      <div class="col-md-6">
        <label class="form-label">Konfirmasi Password Baru *</label>
        <input type="password" name="confirmpw" class="form-control" required minlength="8" autocomplete="new-password" />
      </div>
      <div class="col-12 d-flex gap-2 flex-wrap">
        <button class="btn-accent" type="submit"><i class="bi bi-shield-lock me-1"></i> Simpan Password</button>
        <a class="btn-soft text-decoration-none" href="/customer/akun"><i class="bi bi-x-lg me-1"></i> Batal</a>
      </div>
    </form>
    <script>
      (function () {
        var inp = document.getElementById('newpw');
        if (!inp) return;
        function tick() {
          var v = inp.value;
          document.getElementById('pwLen').classList.toggle('ok', v.length >= 8);
          document.getElementById('pwLetter').classList.toggle('ok', /[A-Za-z]/.test(v));
          document.getElementById('pwDigit').classList.toggle('ok', /\d/.test(v));
        }
        inp.addEventListener('input', tick);
      })();
    </script>

    <% } else { %>
    <div class="akun-detail">
      <div class="detail-row"><div class="dr-label">Nama Lengkap</div><div class="dr-value"><%= akun.name %></div></div>
      <div class="detail-row"><div class="dr-label">Email</div><div class="dr-value"><%= akun.email %></div></div>
      <div class="detail-row"><div class="dr-label">No. HP</div><div class="dr-value"><%= akun.phone || '—' %></div></div>
      <div class="detail-row"><div class="dr-label">Alamat Pengiriman</div><div class="dr-value"><%= akun.address || '—' %></div></div>
      <div class="detail-row"><div class="dr-label">Terdaftar</div><div class="dr-value"><%= formatDateOnly(akun.created_at) %></div></div>
    </div>
    <div class="d-flex gap-2 flex-wrap mt-3">
      <a class="btn-accent" href="/customer/akun?mode=edit"><i class="bi bi-pencil-square me-1"></i> Edit Profil</a>
      <a class="btn-soft text-decoration-none" href="/customer/akun?mode=password"><i class="bi bi-key me-1"></i> Ganti Password</a>
    </div>
    <% } %>
  </div>

  <div class="panel panel-pad">
    <div class="panel-title"><i class="bi bi-graph-up"></i> Aktivitas Belanja</div>
    <div class="panel-sub">Ringkasan akun kamu</div>
    <div class="stat-card mb-3" style="box-shadow:none;border-style:dashed">
      <div class="stat-icon i-violet"><i class="bi bi-bag-check"></i></div>
      <div>
        <div class="stat-label">Total Pesanan</div>
        <div class="stat-value"><%= stats.orders %></div>
      </div>
    </div>
    <div class="stat-card mb-3" style="box-shadow:none;border-style:dashed">
      <div class="stat-icon i-pink"><i class="bi bi-cash-stack"></i></div>
      <div>
        <div class="stat-label">Total Belanja</div>
        <div class="stat-value" style="font-size:18px"><%= formatRp(stats.spent) %></div>
      </div>
    </div>
    <div class="stat-card mb-0" style="box-shadow:none;border-style:dashed">
      <div class="stat-icon i-teal"><i class="bi bi-star-fill"></i></div>
      <div>
        <div class="stat-label">Ulasan Diberikan</div>
        <div class="stat-value"><%= stats.reviews %></div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
