<%- include('../partials/head', { title: title, nav: 'customer-nav', active: 'pesanan' }) %>

<div class="page-head">
  <div>
    <h1>Pesanan Saya</h1>
    <div class="sub">Riwayat pesanan beserta status terkininya</div>
  </div>
  <a href="/customer/katalog" class="btn-accent"><i class="bi bi-cart-plus me-1"></i> Belanja Lagi</a>
</div>

<% if (!orders.length) { %>
  <div class="panel">
    <div class="empty-state">
      <i class="bi bi-bag-x"></i>
      <div class="title">Belum ada pesanan</div>
      Mulai belanja dari <a class="link-plain" href="/customer/katalog">katalog anggrek</a>.
    </div>
  </div>
<% } %>

<% orders.forEach(function (o) { %>
  <div class="panel panel-pad mb-4">
    <div class="order-head mb-3">
      <div>
        <div class="cell-title" style="font-size:16px">Pesanan #<%= o.id %></div>
        <div class="cell-sub"><%= formatDate(o.created_at) %></div>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (o.items.length) { %>
          <a class="btn-soft" href="/customer/ulasan<%= o.reviewedAll ? '' : '?produk=' + o.reviewTarget %>">
            <i class="bi bi-chat-square-text"></i> <%= o.reviewedAll ? 'Kelola Ulasan' : 'Beri Ulasan' %>
          </a>
        <% } %>
        <span class="badge <%= statusInfo(o.status).cls %>" style="font-size:13px;padding:7px 13px">
          <%= statusInfo(o.status).label %>
        </span>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-them align-middle mb-0">
        <thead>
          <tr><th>Produk</th><th>Harga</th><th>Jumlah</th><th class="text-end">Subtotal</th></tr>
        </thead>
        <tbody>
          <% o.items.forEach(function (i) { %>
            <tr>
              <td class="cell-title"><%= i.item_name %></td>
              <td><%= formatRp(i.price) %></td>
              <td><span class="qty-pill">×<%= i.qty %></span></td>
              <td class="text-end price-tag"><%= formatRp(i.price * i.qty) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="3" class="text-end">Total</th>
            <th class="text-end price-tag"><%= formatRp(o.total) %></th>
          </tr>
        </tfoot>
      </table>
    </div>

    <% if (o.note) { %>
      <div class="note-box mt-3"><i class="bi bi-sticky me-1"></i> <b>Catatan:</b> <%= o.note %></div>
    <% } %>
    <% if (o.status === 'dibatalkan') { %>
      <div class="text-muted-2 mt-2"><i class="bi bi-info-circle me-1"></i> Pesanan ini dibatalkan dan tidak dihitung dalam penjualan.</div>
    <% } %>
  </div>
<% }) %>

<%- include('../partials/foot') %>
