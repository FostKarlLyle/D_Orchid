<%- include('../partials/head', { title: title, nav: 'customer-nav', active: 'ulasan' }) %>

<div class="page-head">
  <div>
    <h1>Ulasan Saya ⭐</h1>
    <div class="sub">Beri ulasan untuk anggrek yang kamu beli, dan kelola ulasan lama</div>
  </div>
</div>

<div class="grid-2-1">
  <!-- Tulis ulasan -->
  <div class="panel panel-pad">
    <div class="panel-title"><i class="bi bi-pencil-square"></i> Tulis Ulasan Baru</div>
    <div class="panel-sub">Satu ulasan untuk setiap produk katalog</div>

    <% if (!candidates.length) { %>
      <div class="demo-box mb-0">
        <i class="bi bi-check-circle text-success me-1"></i>
        Semua produk sudah kamu ulas (atau belum ada produk di katalog). Terima kasih! 🌸
      </div>
    <% } else { %>
      <form method="post" action="/customer/ulasan">
        <div class="mb-3">
          <label class="form-label">Pilih Anggrek *</label>
          <select name="catalog_id" class="form-select" required>
            <option value="">— Pilih produk katalog —</option>
            <% candidates.forEach(function (c) { %>
              <option value="<%= c.catalog_id %>"><%= c.name %> — <%= c.jenis %><%= c.varietas ? ' · ' + c.varietas : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Rating *</label>
          <select name="rating" class="form-select" required>
            <option value="5">★★★★★ (5) — Sangat Puas</option>
            <option value="4">★★★★ (4) — Puas</option>
            <option value="3">★★★ (3) — Cukup</option>
            <option value="2">★★ (2) — Kurang</option>
            <option value="1">★ (1) — Sangat Kurang</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Ulasan *</label>
          <textarea name="comment" class="form-control" rows="4" required
                    placeholder="Ceritakan pengalamanmu dengan anggrek ini..."></textarea>
        </div>
        <button class="btn-accent" type="submit"><i class="bi bi-send me-1"></i> Kirim Ulasan</button>
      </form>
    <% } %>
  </div>

  <!-- Ringkasan -->
  <div class="panel panel-pad">
    <div class="panel-title"><i class="bi bi-emoji-smile"></i> Ringkasan</div>
    <div class="panel-sub">Aktivitas ulasan kamu</div>
    <div class="stat-card mb-3" style="box-shadow:none;border-style:dashed">
      <div class="stat-icon i-violet"><i class="bi bi-star-fill"></i></div>
      <div>
        <div class="stat-label">Ulasan Diberikan</div>
        <div class="stat-value"><%= myReviews.length %></div>
        <div class="stat-note">rata-rata rating <%= avg %></div>
      </div>
    </div>
    <div class="demo-box mb-0">
      <i class="bi bi-shield-check me-1"></i>
      Ulasanmu membantu customer lain memilih anggrek terbaik.
    </div>
  </div>
</div>

<!-- Daftar ulasan saya -->
<div class="page-head" style="margin-top:8px">
  <div>
    <h1 style="font-size:17px">Ulasan yang Sudah Diberikan</h1>
  </div>
</div>

<% if (!myReviews.length) { %>
  <div class="panel">
    <div class="empty-state">
      <i class="bi bi-star"></i>
      <div class="title">Belum ada ulasan darimu</div>
      Tulis ulasan pertama di formulir di atas.
    </div>
  </div>
<% } %>

<% myReviews.forEach(function (r) { %>
  <div class="panel panel-pad review-card mb-4">
    <div class="d-flex flex-wrap justify-content-between gap-3">
      <div>
        <div class="cell-title"><%= r.orchid_name || 'Produk dihapus' %></div>
        <div class="review-meta"><%= formatDate(r.created_at) %></div>
      </div>
      <div class="text-end">
        <div class="stars">
          <% for (var s = 1; s <= 5; s++) { %>
            <span class="<%= s <= r.rating ? '' : 'dim' %>">★</span>
          <% } %>
          <b class="ms-1"><%= r.rating %>/5</b>
        </div>
        <form method="post" action="/customer/ulasan/<%= r.id %>/hapus" class="d-inline mt-1"
              onsubmit="return confirm('Hapus ulasan ini?')">
          <button class="btn-icon b-del" type="submit" title="Hapus ulasan"><i class="bi bi-trash3"></i></button>
        </form>
      </div>
    </div>
    <p class="mt-3 mb-0" style="font-size:14.5px"><%= r.comment %></p>
    <% if (r.reply) { %>
      <div class="reply-box">
        <b><i class="bi bi-reply me-1"></i>Balasan Admin</b> <span class="review-meta">· <%= r.replied_at ? formatDate(r.replied_at) : '' %></span>
        <div class="mt-1"><%= r.reply %></div>
      </div>
    <% } %>
  </div>
<% }) %>

<%- include('../partials/foot') %>
