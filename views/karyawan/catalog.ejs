<%- include('../partials/head', { title: title, nav: 'karyawan-nav', active: 'katalog' }) %>

<div class="page-head">
  <div>
    <h1>Katalog Anggrek</h1>
    <div class="sub">Lihat dan ubah data katalog yang dipilih admin</div>
  </div>
</div>

<div class="panel" style="margin-bottom:18px">
  <div class="panel-pad pb-0 d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div class="text-muted-2">
      <i class="bi bi-info-circle me-1"></i>
      Penambahan katalog dilakukan oleh <b>Admin</b>. Di sini kamu bisa mengubah harga & status.
    </div>
    <form class="d-flex gap-2 mb-3" method="get" action="/karyawan/katalog">
      <div class="search-box">
        <i class="bi bi-search"></i>
        <input class="form-control" type="text" name="q" value="<%= q %>" placeholder="Cari nama / jenis / varietas..." />
      </div>
      <button class="btn-soft" type="submit">Cari</button>
      <% if (q) { %><a href="/karyawan/katalog" class="btn-soft">Reset</a><% } %>
    </form>
  </div>

  <div class="table-responsive mt-3">
    <table class="table table-them align-middle">
      <thead>
        <tr>
          <th>Produk</th>
          <th>Fase</th>
          <th>Harga</th>
          <th>Stok</th>
          <th>Status</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!items.length) { %>
          <tr><td colspan="6">
            <div class="empty-state"><i class="bi bi-shop"></i>
              <div class="title">Belum ada data di katalog</div>
              Admin akan memilih data anggrekmu ke katalog.
            </div>
          </td></tr>
        <% } %>
        <% items.forEach(function (it) { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <% if (it.image) { %><img src="<%= it.image %>" class="cell-thumb" alt="" /><% } else { %><div class="cell-thumb empty">🌱</div><% } %>
                <div>
                  <div class="cell-title"><%= it.name %></div>
                  <div class="cell-sub"><%= it.jenis %> · <%= it.varietas || '-' %></div>
                </div>
              </div>
            </td>
            <td><span class="badge badge-fase <%= FASE_BADGE[it.fase] %>"><%= it.fase %></span></td>
            <td class="price-tag"><%= formatRp(it.price) %></td>
            <td><b><%= it.stock %></b> pot</td>
            <td>
              <% if (it.is_active) { %><span class="badge bg-success">Aktif</span><% } else { %><span class="badge bg-secondary">Nonaktif</span><% } %>
            </td>
            <td class="text-end">
              <a class="btn-icon b-edit" href="/karyawan/katalog/<%= it.id %>/ubah" title="Ubah data katalog"><i class="bi bi-pencil"></i></a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>
