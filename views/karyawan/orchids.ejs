<%- include('../partials/head', { title: title, nav: 'karyawan-nav', active: 'anggrek' }) %>

<div class="page-head">
  <div>
    <h1>Manajemen Data Anggrek</h1>
    <div class="sub">Buat, lihat, ubah, dan hapus data anggrek yang dirawat</div>
  </div>
  <a href="/karyawan/anggrek/tambah" class="btn-accent"><i class="bi bi-plus-lg me-1"></i> Buat Data Anggrek</a>
</div>

<div class="panel" style="margin-bottom:18px">
  <div class="panel-pad pb-0 d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div class="text-muted-2">
      <i class="bi bi-lightbulb text-warning me-1"></i>
      Data yang dibuat di sini menjadi kandidat produk katalog pilihan <b>Admin</b>.
    </div>
    <form class="d-flex gap-2 mb-3" method="get" action="/karyawan/anggrek">
      <div class="search-box">
        <i class="bi bi-search"></i>
        <input class="form-control" type="text" name="q" value="<%= q %>" placeholder="Cari nama / jenis / varietas..." />
      </div>
      <select name="fase" class="form-select" style="max-width:150px">
        <option value="">Semua fase</option>
        <% FASE_LIST.forEach(function (f) { %>
          <option value="<%= f %>" <%= fase === f ? 'selected' : '' %>><%= f %></option>
        <% }) %>
      </select>
      <button class="btn-soft" type="submit">Filter</button>
      <% if (q || fase) { %><a href="/karyawan/anggrek" class="btn-soft">Reset</a><% } %>
    </form>
  </div>

  <div class="table-responsive mt-3">
    <table class="table table-them align-middle">
      <thead>
        <tr>
          <th>Anggrek</th>
          <th>Jenis</th>
          <th>Fase</th>
          <th>Stok</th>
          <th>Status Katalog</th>
          <th>Terakhir Diubah</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (!orchids.length) { %>
          <tr><td colspan="7">
            <div class="empty-state">
              <i class="bi bi-flower2"></i>
              <div class="title">Belum ada data anggrek</div>
              Tekan <b>Buat Data Anggrek</b> untuk menambahkan data pertama.
            </div>
          </td></tr>
        <% } %>
        <% orchids.forEach(function (o) { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <% if (o.image) { %><img src="<%= o.image %>" class="cell-thumb" alt="" /><% } else { %><div class="cell-thumb empty">🌱</div><% } %>
                <div>
                  <div class="cell-title"><%= o.name %></div>
                  <div class="cell-sub"><%= o.varietas || 'Tanpa varietas' %> · oleh <%= o.creator_name || '-' %></div>
                </div>
              </div>
            </td>
            <td><%= o.jenis %></td>
            <td><span class="badge badge-fase <%= FASE_BADGE[o.fase] %>"><%= o.fase %></span></td>
            <td><b><%= o.stock %></b> pot</td>
            <td>
              <% if (o.catalog_id) { %>
                <span class="badge bg-success"><i class="bi bi-check-lg"></i> Di katalog</span>
              <% } else { %>
                <span class="badge bg-secondary">Belum dipilih admin</span>
              <% } %>
            </td>
            <td class="cell-sub"><%= formatDate(o.updated_at) %></td>
            <td class="text-end">
              <a class="btn-icon b-edit" href="/karyawan/anggrek/<%= o.id %>/ubah" title="Ubah"><i class="bi bi-pencil"></i></a>
              <form method="post" action="/karyawan/anggrek/<%= o.id %>/hapus" class="d-inline"
                    onsubmit="return confirm('Hapus data &quot;<%= o.name %>&quot;? Jika sedang di katalog, produk ikut terhapus.')">
                <button class="btn-icon b-del" title="Hapus" type="submit"><i class="bi bi-trash3"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>
